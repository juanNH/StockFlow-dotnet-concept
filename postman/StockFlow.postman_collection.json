{
  "info": {
    "name": "StockFlow API",
    "description": "Requests for the API-only StockFlow backend exercise.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/live"
          }
        }
      ]
    },
    {
      "name": "Currency rates",
      "item": [
        {
          "name": "Get USD to EUR rate",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/currency-rates/USD/EUR"
          }
        },
        {
          "name": "Unsupported pair returns 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/currency-rates/ABC/XYZ",
            "description": "Expected response: HTTP 400 ProblemDetails."
          }
        }
      ]
    },
    {
      "name": "Identity",
      "description": "Register an organization and authenticate its owner. Successful register/login responses save accessToken, organizationId, and organizationSlug in the active Postman environment.",
      "item": [
        {
          "name": "Register organization",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationName\": \"Acme Supplies\",\n  \"organizationSlug\": \"acme-supplies\",\n  \"email\": \"owner@acme.test\",\n  \"password\": \"ChangeMe123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "Creates an organization and its initial owner. A successful response contains accessToken, tokenType, expiresAtUtc, organizationId, organizationName, organizationSlug, and role. The script saves accessToken, organizationId, and organizationSlug to the active environment. Use a new organizationSlug and email when registering again."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set('accessToken', data.accessToken);",
                  "  pm.environment.set('organizationId', data.organizationId);",
                  "  pm.environment.set('organizationSlug', data.organizationSlug);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@acme.test\",\n  \"password\": \"ChangeMe123!\",\n  \"organizationSlug\": \"{{organizationSlug}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Authenticates an organization member. A successful response contains accessToken, tokenType, expiresAtUtc, organizationId, organizationName, organizationSlug, and role. The script refreshes accessToken, organizationId, and organizationSlug in the active environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set('accessToken', data.accessToken);",
                  "  pm.environment.set('organizationId', data.organizationId);",
                  "  pm.environment.set('organizationSlug', data.organizationSlug);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current identity",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Returns userId, email, organizationId, organizationName, organizationSlug, and role for the authenticated user. Run Register organization or Login first to populate accessToken."
          }
        }
      ]
    },
    {
      "name": "Products",
      "description": "Authenticated product catalog operations. Run Identity > Register organization or Login first to populate accessToken.",
      "item": [
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SKU-1001\",\n  \"name\": \"Wireless Barcode Scanner\",\n  \"description\": \"Bluetooth barcode scanner for warehouse operations.\",\n  \"unitPrice\": 79.90,\n  \"currency\": \"USD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/products",
            "description": "Creates a product for the authenticated organization. A successful Product response includes id; the script saves it as productId in the active environment. Change the SKU before creating another product."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const product = pm.response.json();",
                  "  pm.environment.set('productId', product.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/products/{{productId}}",
            "description": "Gets one product in the authenticated organization's catalog. Run Create product first to populate productId."
          }
        },
        {
          "name": "Search products (pagination and sorting)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/products?page=1&pageSize=20&search=&sortBy=name&sortDirection=asc&includeInactive=false",
            "description": "Demonstrates paged product search sorted by name ascending. The response contains items, page, pageSize, totalCount, and totalPages. Replace the empty search query to filter by a term."
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SKU-1001\",\n  \"name\": \"Wireless Barcode Scanner\",\n  \"description\": \"Bluetooth barcode scanner for warehouse operations.\",\n  \"unitPrice\": 74.90,\n  \"currency\": \"USD\",\n  \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/products/{{productId}}",
            "description": "Updates the selected product. The request includes isActive in addition to the create fields. Run Create product first to populate productId."
          }
        },
        {
          "name": "Deactivate product",
          "request": {
            "method": "DELETE",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/products/{{productId}}",
            "description": "Deactivates the selected product and returns HTTP 204 No Content. Run Create product first to populate productId."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080",
      "type": "string"
    }
  ]
}
