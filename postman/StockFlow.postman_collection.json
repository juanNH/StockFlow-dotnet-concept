          }
        }
      ]
    },
    {
      "name": "Currency rates",
      "item": [
        {
          "name": "Get USD to EUR rate",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/currency-rates/USD/EUR"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080",
      "type": "string"
    }
